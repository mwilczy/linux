config DRM_VERISILICON_DC8200
	tristate "DRM Support for VeriSilicon DC8200"
	depends on DRM
	select DRM_KMS_HELPER
	select DRM_GEM_DMA_HELPER
	select DMA_CMA if HAVE_DMA_CONTIGUOUS
	select CMA if HAVE_DMA_CONTIGUOUS
	help
	  Say Y or M here if you want to enable support for the VeriSilicon
	  DC8200 display controller, which is found on SoCs such as the
	  StarFive JH7110 and T-HEAD TH1520.

	  This driver provides display output support (DRM/KMS) and buffer
	  management (GEM/DMA). It does not provide 2D or 3D acceleration.
