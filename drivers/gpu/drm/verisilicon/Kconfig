config DRM_VERISILICON_DC8200
	tristate "DRM Support for VeriSilicon DC8200"
	depends on DRM
	select DRM_KMS_HELPER
	select DRM_GEM_DMA_HELPER
	select DMA_CMA if HAVE_DMA_CONTIGUOUS
	select CMA if HAVE_DMA_CONTIGUOUS
	help
	  Say Y or M here if you want to enable support for the VeriSilicon
	  DC8200 display controller, which is found on SoCs such as the
	  StarFive JH7110 and T-HEAD TH1520.

config DRM_INNO_STARFIVE_HDMI
	bool "Innosilicon HDMI Transmitter support for StarFive JH7110"
	depends on DRM_VERISILICON_DC8200
	select DRM_INNO_HDMI
	select DRM_BRIDGE_CONNECTOR
	help
	  Say Y here to build the driver for the Innosilicon HDMI bridge
	  transmitter as found on the StarFive JH7110 SoC. This driver
	  acts as a glue layer between the main DC8200 display controller
	  and the generic Innosilicon HDMI bridge driver.
